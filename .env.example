# --- backend ---
# Comma-separated key pool, at least 2. Ids are key_1, key_2, ... in this order.
# Keys from the same account usually share one quota, so use two accounts/projects or two providers.
LLM_API_KEYS=your-groq-key,your-nvidia-key
# One LiteLLM model per key, same order as LLM_API_KEYS (lets keys span providers).
# Open-weight models on two providers: key_1 = Groq, key_2 = NVIDIA NIM (build.nvidia.com).
LLM_MODELS=groq/openai/gpt-oss-120b,nvidia_nim/nvidia/nemotron-3.5-lightning-30b-a3b
# Used for every key when LLM_MODELS is empty.
LLM_MODEL=gemini/gemini-2.5-flash-lite
# SQLite file; /data is the Docker named volume.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (add your deployed frontend URL).
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure header (must be true on the deployed backend).
ENABLE_FAILURE_SIMULATION=true
# Optional
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
LLM_TIMEOUT_SECONDS=30

# --- frontend (build time) ---
VITE_API_URL=http://localhost:8000
