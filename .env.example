# --- backend ---
# Comma-separated key pool, at least 2. Ids are key_1, key_2, ... in this order.
# Free Gemini keys: https://aistudio.google.com/apikey (create each key in a DIFFERENT
# Google Cloud project, otherwise they share one quota and fail together).
LLM_API_KEYS=your-first-key,your-second-key
# Any LiteLLM model string; every key in the pool must be valid for it.
LLM_MODEL=gemini/gemini-2.5-flash-lite
# SQLite file; /data is the Docker named volume.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (add your deployed frontend URL).
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure header (must be true on the deployed backend).
ENABLE_FAILURE_SIMULATION=true
# Optional
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
LLM_TIMEOUT_SECONDS=30

# --- frontend (build time) ---
VITE_API_URL=http://localhost:8000
